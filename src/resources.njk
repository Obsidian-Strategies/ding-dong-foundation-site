<section class="section section--page" id="questions">
  <div class="wrap stack stack--lg">
    <h2 class="m0">Questions</h2>
    <div class="faq" data-faq>
      <div class="faq__list" role="list">
        {%- for item in items %}
        <div class="faq__item" role="listitem" data-faq-item>
          <h3 class="faq__q">
            <button class="faq__bar" type="button" id="faq-{{ item.id }}" aria-expanded="false" aria-controls="faq-{{ item.id }}-body" data-faq-bar>
              <span>{{ item.q }}</span>
              <i class="ph ph-arrow-right icon icon--sm faq__arrow" aria-hidden="true"></i>
            </button>
          </h3>
          <div class="faq__body" id="faq-{{ item.id }}-body" role="region" aria-labelledby="faq-{{ item.id }}" data-faq-body>
            <p>{{ item.a | safe }}</p>
          </div>
        </div>
        {%- endfor %}
      </div>
      <div class="faq__detail" data-faq-panel aria-live="polite" aria-atomic="true"></div>
    </div>
  </div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for item in items %}
    { "@type": "Question", "name": {{ item.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | striptags | dump | safe }} } }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
