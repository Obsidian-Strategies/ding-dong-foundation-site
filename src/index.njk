      <div class="card card--accent card--interactive fund__card" data-fund-card>
        <div class="card__photo" aria-hidden="true"><img src="{{ '/uploads/fund-bells.jpg' | url }}" alt="" width="1024" height="768" loading="lazy"></div>
        <i class="ph ph-bell-simple icon icon--lg icon--brass" aria-hidden="true"></i>
        <h3 class="card__title">Bells and towers</h3>
        <p class="muted m0">Repair, rehanging, and new rings. Electronic carillons for churches with no bells at all.</p>
      </div>
      <div class="card card--accent card--interactive fund__card" data-fund-card>
        <div class="card__photo" aria-hidden="true"><img src="{{ '/uploads/fund-organ.jpg' | url }}" alt="" width="1024" height="768" loading="lazy"></div>
        <i class="ph ph-music-notes icon icon--lg icon--brass" aria-hidden="true"></i>
        <h3 class="card__title">Pipe organs</h3>
        <p class="muted m0">Restoration, purchase, and the tuning that keeps them honest.</p>
      </div>
      <div class="card card--accent card--interactive fund__card" data-fund-card>
        <div class="card__photo" aria-hidden="true"><img src="{{ '/uploads/fund-glass.jpg' | url }}" alt="" width="1600" height="1200" loading="lazy"></div>
        <i class="ph ph-church icon icon--lg icon--brass" aria-hidden="true"></i>
